POSTGRES_DB=mini_erp_db
POSTGRES_USER=mini_erp_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://mini_erp_user:replace-with-a-strong-database-password@localhost:5434/mini_erp_db
APP_DEBUG=false
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
