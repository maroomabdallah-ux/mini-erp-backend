APP_NAME=Mini ERP System
APP_VERSION=1.1.0
DEBUG=false
DATABASE_URL=postgresql+psycopg://mini_erp_user:mini_erp_password@postgres:5432/mini_erp_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
