APP_NAME=Mini ERP System
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_NAME=mini_erp_db
DATABASE_USER=mini_erp_user
DATABASE_PASSWORD=mini_erp_password

DATABASE_URL=postgresql+psycopg://mini_erp_user:mini_erp_password@localhost:5434/mini_erp_db

JWT_SECRET=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

BCRYPT_ROUNDS=12

CORS_ORIGINS=http://localhost:5173
